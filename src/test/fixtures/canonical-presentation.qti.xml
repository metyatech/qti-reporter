<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item identifier="canonical-presentation" title="Canonical Presentation" adaptive="false" time-dependent="false" xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0">
  <qti-response-declaration identifier="CHOICE_RESPONSE" base-type="identifier" cardinality="single">
    <qti-correct-response>
      <qti-value>CHOICE_A</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-response-declaration identifier="CLOZE_RESPONSE" base-type="string" cardinality="single">
    <qti-correct-response>
      <qti-value>A</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="FEEDBACK" cardinality="single" base-type="identifier" />
  <qti-item-body>
    <p>
      before
      <span style="display:inline-block;min-width:4em;border:1px solid #000;text-align:center;background:transparent;" class="answer" data-slot="a" aria-label="answer">A</span>
      after
    </p>
    <pre><code>foo <span style="display:inline-block;min-width:4em;border:1px solid #000;text-align:center;background:transparent;">A</span> bar</code></pre>
    <pre><code>foo <qti-text-entry-interaction response-identifier="CLOZE_RESPONSE" /> bar</code></pre>
    <p><img src="images/sample.svg" alt="sample image" /><br /><hr /></p>
    <qti-choice-interaction response-identifier="CHOICE_RESPONSE" max-choices="1">
      <qti-simple-choice identifier="CHOICE_A"><strong>Rich</strong> <em>choice</em> <a href="#choice">link</a></qti-simple-choice>
      <qti-simple-choice identifier="CHOICE_B">Plain choice</qti-simple-choice>
    </qti-choice-interaction>
    <qti-rubric-block view="scorer">
      <p>[2] criterion</p>
    </qti-rubric-block>
  </qti-item-body>
  <qti-modal-feedback identifier="EXPLANATION" outcome-identifier="FEEDBACK" show-hide="show">
    <qti-content-body>
      <p><strong>Candidate explanation</strong> with <span class="explanation-mark">rich HTML</span>.</p>
      <ul><li>First explanation point</li><li><code>inline()</code> detail</li></ul>
    </qti-content-body>
  </qti-modal-feedback>
</qti-assessment-item>
