{
  "name": "qti-reporter",
  "version": "1.2.0",
  "description": "qti-reporter generates human-readable HTML reports per respondent and an aggregated CSV report from QTI 3.0 assessment items and results.",
  "main": "dist/cli.js",
  "bin": {
    "qti-reporter": "dist/cli.js"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm test",
    "prepare": "husky && npm run build",
    "test": "npm run build && node scripts/run-tests.mjs",
    "start": "npm run build && node dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metyatech/qti-reporter.git"
  },
  "keywords": [],
  "author": "metyatech",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/metyatech/qti-reporter/issues"
  },
  "homepage": "https://github.com/metyatech/qti-reporter#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/cli.js",
    "dist/qti",
    "dist/report",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.0.10",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "jsdom": "^27.4.0",
    "qti-html-renderer": "github:metyatech/qti-html-renderer#5a08b4996048edf03ff4dc9039d1ef10d450ea9a",
    "qti-xml-core": "github:metyatech/qti-xml-core#f96a1ad7ee20dd9a4ae2bb7beb025a3ad8638f94"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "ajv": "^6.14.0"
  },
  "lint-staged": {
    "**/*.ts": [
      "prettier --check",
      "eslint"
    ],
    "*.{json,md}": [
      "prettier --check"
    ]
  },
  "allowScripts": {
    "github:metyatech/qti-html-renderer#5a08b4996048edf03ff4dc9039d1ef10d450ea9a": true,
    "github:metyatech/qti-xml-core#b3f389a2cec7cd9429b4d5dcf5efeaff3b5a9c75": true,
    "github:metyatech/qti-xml-core#f96a1ad7ee20dd9a4ae2bb7beb025a3ad8638f94": true
  }
}
